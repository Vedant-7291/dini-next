{
  "name": "smartdini-monorepo",
  "version": "1.0.0",
  "description": "SmartDini restaurant management system",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd app/frontend && npm run dev",
    "dev:backend": "cd server && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd app/frontend && npm run build",
    "build:backend": "cd server && npm install",
    "start": "npm run start:backend",
    "start:backend": "cd server && npm start",
    "start:frontend": "cd app/frontend && npm start",
    "install:all": "npm install && cd server && npm install && cd ../app/frontend && npm install",
    "lint": "cd app/frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
